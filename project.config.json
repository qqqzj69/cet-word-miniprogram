{
  "description": "CET 词汇 · 英语四六级背单词小程序",
  "compileType": "miniprogram",
  "appid": "touristappid",
  "projectname": "cet-word",
  "libVersion": "3.0.0",
  "setting": {
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "urlCheck": false,
    "coverView": true,
    "lazyloadPlaceholderEnable": false,
    "ignoreUploadUnusedFiles": true,
    "useCompilerPlugins": false,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    }
  },
  "condition": {},
  "packOptions": {
    "ignore": [
      { "type": "folder", "value": "tools" },
      { "type": "folder", "value": "tests" },
      { "type": "folder", "value": "docs" },
      { "type": "file", "value": "README.md" },
      { "type": "file", "value": ".gitignore" }
    ],
    "include": []
  },
  "editorSetting": {
    "tabIndent": "insertSpaces",
    "tabSize": 2
  }
}
