/**
 * 全局设计令牌 + 基础样式
 * 视觉方向：「晨读纸感」Light Academic
 * 浅暖纸底 / 靛青-青绿主色 / 大圆角 / 双层浅阴影
 */

page {
  /* ---- 颜色 ---- */
  --bg: #F6F4F1;
  --bg-soft: #EFEBE6;
  --card: #FFFFFF;
  --ink: #16181D;
  --ink-2: #5B616E;
  --ink-3: #9AA0AC;
  --line: rgba(22, 24, 29, 0.07);
  --brand: #2F5FE0;
  --brand-2: #17B8A6;
  --brand-soft: rgba(47, 95, 224, 0.08);
  --amber: #F5A623;
  --coral: #FF6B5B;
  --green: #16A34A;

  /* ---- 圆角 / 阴影 ---- */
  --r-lg: 32rpx;
  --r-md: 24rpx;
  --r-sm: 16rpx;
  --shadow-card: 0 2rpx 6rpx rgba(22, 24, 29, 0.04), 0 12rpx 32rpx rgba(22, 24, 29, 0.06);
  --shadow-float: 0 8rpx 24rpx rgba(47, 95, 224, 0.28);

  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC",
    "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

@media (prefers-color-scheme: dark) {
  page {
    --bg: #101216;
    --bg-soft: #1A1D24;
    --card: #191C22;
    --ink: #F2F4F8;
    --ink-2: #A3AAB8;
    --ink-3: #6B7280;
    --line: rgba(255, 255, 255, 0.08);
    --brand: #5B84F5;
    --brand-2: #2BD4C0;
    --brand-soft: rgba(91, 132, 245, 0.14);
    --r-lg: 32rpx;
    --shadow-card: 0 2rpx 6rpx rgba(0, 0, 0, 0.30), 0 12rpx 32rpx rgba(0, 0, 0, 0.34);
    --shadow-float: 0 8rpx 24rpx rgba(0, 0, 0, 0.45);
    background: var(--bg);
    color: var(--ink);
  }
}

/* ================= 通用布局 ================= */

.page-pad {
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.card {
  background: var(--card);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--line);
  box-sizing: border-box;
}

.h1 { font-size: 52rpx; font-weight: 700; letter-spacing: -0.5rpx; }
.h2 { font-size: 36rpx; font-weight: 600; }
.h3 { font-size: 30rpx; font-weight: 600; }
.t2 { color: var(--ink-2); }
.t3 { color: var(--ink-3); }
.num { font-variant-numeric: tabular-nums; letter-spacing: -0.5rpx; }

/* ================= 按钮 ================= */

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: var(--r-sm);
  font-size: 32rpx;
  font-weight: 600;
  transition: transform 0.12s ease, opacity 0.2s ease;
}

.btn::after { border: none; }

.btn:active { transform: scale(0.96); opacity: 0.92; }

.btn-primary {
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-2) 100%);
  color: #fff;
  box-shadow: var(--shadow-float);
}

.btn-ghost {
  background: var(--brand-soft);
  color: var(--brand);
}

.btn-disabled {
  opacity: 0.4;
  pointer-events: none;
  box-shadow: none;
}

/* ================= 标签 ================= */

.chip {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
  background: var(--brand-soft);
  color: var(--brand);
}

/* ================= 动效 ================= */

.fade-up {
  animation: fadeUp 0.42s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.pop {
  animation: pop 0.36s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

@keyframes pop {
  from { opacity: 0; transform: scale(0.82); }
  to { opacity: 1; transform: scale(1); }
}
