/**
 * 全局设计令牌 + 基础样式
 * 视觉方向：浅色半透明毛玻璃（Light Glassmorphism）
 * 柔和渐变天空底 + 白色磨砂卡片 + 深色字阶 + 大号细体数字
 *
 * 说明：本次为纯视觉重做，未改动任何业务逻辑。
 */

page {
  /* ---- 天空底色（浅色系） ---- */
  --sky-1: #EAF3FF;          /* 天顶：晨雾蓝 */
  --sky-2: #E3ECFF;          /* 中段：浅蓝 */
  --sky-3: #F2E9FF;          /* 地平线：淡紫 */

  /* ---- 玻璃 ---- */
  --glass: rgba(255, 255, 255, 0.55);        /* 卡片 */
  --glass-2: rgba(255, 255, 255, 0.75);      /* 按钮 */
  --glass-line: rgba(255, 255, 255, 0.85);   /* 高光描边 */
  --glass-hi: rgba(255, 255, 255, 0.95);     /* 顶部内高光 */
  --track: rgba(255, 255, 255, 0.70);        /* 进度底槽 */
  --hair: rgba(28, 28, 30, 0.10);            /* 分隔线 */

  /* ---- 文字（深阶） ---- */
  --ink: #1C1C1E;
  --ink-2: rgba(28, 28, 30, 0.68);
  --ink-3: rgba(28, 28, 30, 0.45);

  /* ---- Apple 系统色（浅底适配） ---- */
  --brand: #0A84FF;          /* blue */
  --brand-2: #5E5CE6;        /* indigo */
  --amber: #FF9500;
  --coral: #FF3B30;
  --green: #34C759;

  /* ---- 圆角 / 阴影 ---- */
  --r-lg: 36rpx;
  --r-md: 28rpx;
  --r-sm: 20rpx;
  --shadow-card: 0 8rpx 32rpx rgba(31, 38, 135, 0.10);
  --shadow-float: 0 10rpx 28rpx rgba(10, 132, 255, 0.26);

  background: linear-gradient(180deg, var(--sky-1) 0%, var(--sky-2) 48%, var(--sky-3) 100%);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC",
    "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* ================= 天空背景层 ================= */

.bg {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
}

/* 柔和光晕：浅色系的粉蓝紫彩斑 */
.blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(80rpx);
  opacity: 0.55;
}

.blob-1 {
  width: 560rpx;
  height: 560rpx;
  left: -160rpx;
  top: -80rpx;
  background: radial-gradient(circle, #8FD3FF 0%, rgba(143, 211, 255, 0) 70%);
  animation: drift1 18s ease-in-out infinite;
}

.blob-2 {
  width: 620rpx;
  height: 620rpx;
  right: -200rpx;
  top: 300rpx;
  background: radial-gradient(circle, #CBB8FF 0%, rgba(203, 184, 255, 0) 70%);
  animation: drift2 22s ease-in-out infinite;
}

.blob-3 {
  width: 480rpx;
  height: 480rpx;
  left: 100rpx;
  bottom: -160rpx;
  background: radial-gradient(circle, #FFD3B6 0%, rgba(255, 211, 182, 0) 70%);
  animation: drift1 26s ease-in-out infinite reverse;
}

@keyframes drift1 {
  0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
  50% { transform: translate3d(40rpx, 60rpx, 0) scale(1.08); }
}

@keyframes drift2 {
  0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
  50% { transform: translate3d(-50rpx, -40rpx, 0) scale(1.12); }
}

/* ================= 通用布局 ================= */

.page-pad {
  position: relative;
  z-index: 1;
  padding: 24rpx 28rpx 48rpx;
  box-sizing: border-box;
}

/* 白色磨砂玻璃卡片 */
.card {
  position: relative;
  background: var(--glass);
  -webkit-backdrop-filter: blur(28px) saturate(180%);
  backdrop-filter: blur(28px) saturate(180%);
  border-radius: var(--r-lg);
  border: 1rpx solid var(--glass-line);
  box-shadow: var(--shadow-card), inset 0 1rpx 0 var(--glass-hi);
  box-sizing: border-box;
  overflow: hidden;
}

/* 大号细体数字 */
.h1 { font-size: 60rpx; font-weight: 300; letter-spacing: -1rpx; }
.h2 { font-size: 38rpx; font-weight: 500; }
.h3 { font-size: 30rpx; font-weight: 500; }
.t2 { color: var(--ink-2); }
.t3 { color: var(--ink-3); }
.num { font-variant-numeric: tabular-nums; letter-spacing: -0.5rpx; }

/* ================= 按钮 ================= */

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: var(--r-sm);
  font-size: 32rpx;
  font-weight: 500;
  color: var(--ink);
  background: var(--glass-2);
  -webkit-backdrop-filter: blur(20px);
  backdrop-filter: blur(20px);
  border: 1rpx solid var(--glass-line);
  box-shadow: inset 0 1rpx 0 var(--glass-hi);
  transition: transform 0.12s ease, opacity 0.2s ease;
}

.btn::after { border: none; }

.btn:active { transform: scale(0.96); opacity: 0.88; }

.btn-primary {
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-2) 100%);
  border-color: rgba(255, 255, 255, 0.6);
  color: #fff;
  box-shadow: var(--shadow-float), inset 0 1rpx 0 rgba(255, 255, 255, 0.35);
}

.btn-ghost {
  background: rgba(255, 255, 255, 0.55);
  color: var(--ink);
}

.btn-disabled {
  opacity: 0.38;
  pointer-events: none;
  box-shadow: none;
}

/* ================= 标签 ================= */

.chip {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
  background: rgba(255, 255, 255, 0.72);
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
  border: 1rpx solid var(--glass-line);
  color: var(--ink-2);
}

/* ================= 进度条 ================= */

.prog-bar {
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--track);
  overflow: hidden;
}

.prog-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--brand) 0%, var(--brand-2) 100%);
  transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1);
}

/* ================= 动效 ================= */

.fade-up {
  animation: fadeUp 0.42s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.pop {
  animation: pop 0.36s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

@keyframes pop {
  from { opacity: 0; transform: scale(0.82); }
  to { opacity: 1; transform: scale(1); }
}

/* 分隔线 */
.hairline {
  height: 1rpx;
  background: var(--hair);
}
