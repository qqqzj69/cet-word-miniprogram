.w-head {
  padding: 24rpx 8rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.w-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 300;
}

/* ---------- 复习入口 ---------- */
.w-cta {
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, rgba(255, 59, 48, 0.14) 0%, rgba(255, 149, 0, 0.16) 100%);
}

.w-cta-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 300;
}

.w-cta-arrow {
  color: #FF3B30;
  font-size: 44rpx;
  line-height: 1;
}

/* ---------- 空状态 ---------- */
.w-empty {
  margin-top: 24rpx;
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  text-align: center;
}

.w-empty-icon { font-size: 72rpx; }

.w-empty-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  font-weight: 300;
}

/* ---------- 列表 ---------- */
.w-list { margin-top: 24rpx; }

.w-item {
  margin-bottom: 20rpx;
  padding: 28rpx 32rpx;
  overflow: hidden;
}

.w-item-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.w-item-sub {
  font-size: 24rpx;
  margin-top: 4rpx;
  font-weight: 300;
}

.w-item-arrow {
  color: var(--ink-3);
  font-size: 40rpx;
  line-height: 1;
  transition: transform 0.25s ease;
}

.w-item-arrow-open {
  transform: rotate(90deg);
}

.w-item-detail {
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  transition: max-height 0.3s ease, opacity 0.25s ease, margin-top 0.3s ease;
}

.w-item-detail-open {
  max-height: 600rpx;
  opacity: 1;
  margin-top: 20rpx;
}

.w-item-meaning {
  font-size: 28rpx;
  line-height: 1.7;
  font-weight: 300;
  color: var(--ink-2);
  word-break: break-all;
}

.w-item-btn {
  margin-top: 20rpx;
  height: 72rpx;
  font-size: 26rpx;
}
