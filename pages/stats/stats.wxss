/* ---------- 打卡主卡 ---------- */
.s-hero {
  margin-top: 12rpx;
  padding: 44rpx 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, rgba(255, 149, 0, 0.18) 0%, rgba(255, 59, 48, 0.12) 100%);
}

.s-streak {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.s-streak-num {
  font-size: 96rpx;
  font-weight: 200;
  line-height: 1;
  color: #FF9500;
  letter-spacing: -3rpx;
}

.s-streak-unit {
  font-size: 30rpx;
  color: rgba(255, 149, 0, 0.95);
  font-weight: 300;
}

.s-streak-label {
  margin-top: 12rpx;
  font-size: 26rpx;
  font-weight: 300;
}

.s-streak-sub {
  margin-top: 2rpx;
  font-size: 22rpx;
  font-weight: 300;
}

.s-checkin {
  width: 220rpx;
  height: 88rpx;
  font-size: 28rpx;
}

/* ---------- 今日数据 ---------- */
.s-grid {
  margin-top: 24rpx;
  display: flex;
  gap: 24rpx;
}

.s-cell {
  flex: 1;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.s-cell-num {
  font-size: 56rpx;
  font-weight: 200;
  line-height: 1.1;
  letter-spacing: -1rpx;
}

.s-cell-label { font-size: 24rpx; font-weight: 300; }

/* ---------- 近 7 天 ---------- */
.s-week {
  margin-top: 24rpx;
  padding: 32rpx;
}

.s-week-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.s-week-total { font-size: 24rpx; font-weight: 300; }

.s-chart {
  margin-top: 32rpx;
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  height: 280rpx;
}

.s-col {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.s-col-val {
  font-size: 22rpx;
  font-weight: 300;
  color: var(--ink-2);
  line-height: 1;
}

.s-bar-track {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

/* 玻璃柱体：未达成是半透明白，今天用高亮渐变 */
.s-bar {
  width: 32rpx;
  min-height: 8rpx;
  border-radius: 999rpx;
  background: rgba(120, 130, 180, 0.22);
  transition: height 0.6s cubic-bezier(0.22, 1, 0.36, 1);
}

.s-bar-hot {
  background: linear-gradient(180deg, var(--brand) 0%, var(--brand-2) 100%);
}

.s-col-label {
  font-size: 22rpx;
  font-weight: 300;
}

.s-col-label-hot {
  color: var(--brand);
  font-weight: 500;
}

/* ---------- 累计 ---------- */
.s-acc {
  margin-top: 24rpx;
  padding: 32rpx;
}

.s-acc-grid {
  margin-top: 28rpx;
  display: flex;
}

.s-acc-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.s-acc-num {
  font-size: 44rpx;
  font-weight: 200;
  letter-spacing: -1rpx;
}

.s-acc-label { font-size: 22rpx; font-weight: 300; }

.prog-bar {
  margin-top: 32rpx;
}

.s-acc-foot {
  margin-top: 16rpx;
  font-size: 24rpx;
  font-weight: 300;
  text-align: center;
}
