<view class="bg">
  <view class="blob blob-1"></view>
  <view class="blob blob-2"></view>
  <view class="blob blob-3"></view>
</view>

<view class="page-pad" wx:if="{{st}}">
  <!-- 打卡主卡 -->
  <view class="card s-hero fade-up">
    <view class="s-hero-left">
      <view class="s-streak num">
        <text class="s-streak-num">{{st.streak}}</text>
        <text class="s-streak-unit">天</text>
      </view>
      <view class="t2 s-streak-label">连续打卡</view>
      <view class="t3 s-streak-sub num">累计 {{st.totalCheckins}} 天</view>
    </view>
    <view
      class="btn s-checkin {{st.checkedToday ? 'btn-disabled' : ''}}"
      bindtap="onCheckin"
    >
      {{st.checkedToday ? '今日已打卡' : '立即打卡'}}
    </view>
  </view>

  <!-- 今日数据 -->
  <view class="s-grid fade-up">
    <view class="card s-cell">
      <view class="s-cell-num num">{{st.today.learned}}</view>
      <view class="t3 s-cell-label">今日学习</view>
    </view>
    <view class="card s-cell">
      <view class="s-cell-num num">{{st.accuracy}}%</view>
      <view class="t3 s-cell-label">今日正确率</view>
    </view>
  </view>

  <!-- 近 N 天：可切换区间 -->
  <view class="card s-week fade-up">
    <view class="s-week-head">
      <view class="h3">学习趋势</view>
      <view class="s-range">
        <view
          class="s-range-item num {{range === item.value ? 's-range-on' : ''}}"
          wx:for="{{ranges}}"
          wx:key="value"
          data-r="{{item.value}}"
          bindtap="onPickRange"
          hover-class="m-hover"
        >{{item.label}}</view>
      </view>
    </view>
    <view class="t3 s-week-total num">
      近 {{range}} 天共学 {{st.rangeTotal}} 词 · 有记录 {{st.rangeActiveDays}} 天 · 日均 {{st.rangeAvg}} 词
    </view>
    <view class="s-chart s-chart-{{range}}">
      <view class="s-col" wx:for="{{bars}}" wx:key="index">
        <view class="s-col-val num" wx:if="{{!item.isEmpty}}">{{item.value}}</view>
        <view class="s-bar-track">
          <view class="s-bar {{item.isToday ? 's-bar-hot' : ''}}" style="height:{{item.hPct}}%"></view>
        </view>
        <view class="t3 s-col-label {{item.isToday ? 's-col-label-hot' : ''}}">{{item.label}}</view>
      </view>
    </view>
  </view>

  <!-- 艾宾浩斯遗忘曲线 -->
  <view class="card s-curve fade-up">
    <view class="s-curve-head">
      <view class="h3">记忆留存曲线</view>
      <view class="t3 s-curve-sub">最近 {{curve.length}} 天</view>
    </view>

    <view class="s-legend">
      <view class="s-legend-item">
        <view class="s-legend-line"></view>
        <text class="t3">实际留存</text>
      </view>
      <view class="s-legend-item">
        <view class="s-legend-line s-legend-dash"></view>
        <text class="t3">不复习的理论遗忘</text>
      </view>
    </view>

    <canvas
      type="2d"
      id="forgetCurve"
      class="s-curve-canvas"
      bindtap="onCurveTap"
      wx:if="{{curveReady}}"
    ></canvas>

    <view class="s-curve-empty" wx:else>
      <text class="t3">至少两天的学习记录才能画出曲线，先去背两天再来</text>
    </view>

    <!-- 点击节点后的单词列表 -->
    <view class="s-curve-detail" wx:if="{{curveDate}}">
      <view class="s-curve-detail-head">
        <text class="s-curve-date num">{{curveDate}}</text>
        <text class="t3">学 {{curveLearned}} 词 · 平均留存 {{curveRetention}}%</text>
      </view>
      <view class="f-word" wx:for="{{curveWords}}" wx:key="index">
        <view class="f-word-main">
          <view class="f-word-en">{{item.w}}</view>
          <view class="t3 f-word-cn">{{item.m}}</view>
        </view>
        <view class="f-word-tag f-word-{{item.r}}">{{item.rText}}</view>
      </view>
      <view class="t3 f-word-empty" wx:if="{{curveWords.length === 0}}">这天没有留下单词明细</view>
    </view>
  </view>

  <!-- 累计：可点开查看错词与学习记录 -->
  <view class="card s-acc fade-up" hover-class="row-hover" bindtap="onOpenAcc">
    <view class="s-acc-head">
      <view class="h3">{{st.levelName}} · 累计</view>
      <view class="s-acc-link">错词与学习记录 ›</view>
    </view>
    <view class="s-acc-grid num">
      <view class="s-acc-cell">
        <view class="s-acc-num">{{st.acc.learned}}</view>
        <view class="t3 s-acc-label">已学词数</view>
      </view>
      <view class="s-acc-cell">
        <view class="s-acc-num" style="color:#248A3D">{{st.acc.mastered}}</view>
        <view class="t3 s-acc-label">已掌握</view>
      </view>
      <view class="s-acc-cell">
        <view class="s-acc-num" style="color:#FF3B30">{{st.acc.wrong}}</view>
        <view class="t3 s-acc-label">错词</view>
      </view>
      <view class="s-acc-cell">
        <view class="s-acc-num">{{st.totalLearned}}</view>
        <view class="t3 s-acc-label">累计学习</view>
      </view>
    </view>
    <view class="prog-bar">
      <view class="prog-fill" style="width:{{st.acc.total ? (st.acc.learned * 100 / st.acc.total) : 0}}%"></view>
    </view>
    <view class="t3 s-acc-foot num">词库进度 {{st.acc.learned}} / {{st.acc.total}}</view>
  </view>
</view>
