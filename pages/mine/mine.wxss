/* ---------- 顶部概览 ---------- */
.m-head {
  margin-top: 12rpx;
  padding: 44rpx 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, rgba(100, 210, 255, 0.24) 0%, rgba(125, 122, 255, 0.22) 100%);
}

.m-head-ring {
  display: flex;
  flex-direction: column;
}

.m-head-sub {
  font-size: 24rpx;
  font-weight: 300;
  margin-top: 4rpx;
}

.m-head-meta {
  display: flex;
  gap: 40rpx;
}

.m-meta-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.m-meta-num {
  font-size: 44rpx;
  font-weight: 200;
  letter-spacing: -1rpx;
}

.m-meta-label { font-size: 22rpx; font-weight: 300; }

/* ---------- 分块 ---------- */
.m-block {
  margin-top: 24rpx;
  padding: 32rpx;
}

.m-block-title {
  margin-bottom: 24rpx;
}

.m-hover { transform: scale(0.985); transition: transform 0.12s ease; }

/* ---------- 词库选择 ---------- */
.m-levels {
  display: flex;
  gap: 20rpx;
}

.m-level {
  flex: 1;
  position: relative;
  padding: 28rpx;
  border-radius: var(--r-md);
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  transition: border-color 0.2s ease, background 0.2s ease, transform 0.12s ease;
}

.m-level-on {
  border-color: rgba(100, 210, 255, 0.75);
  background: rgba(100, 210, 255, 0.18);
}

.m-level-name {
  font-size: 30rpx;
  font-weight: 500;
}

.m-level-count {
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 300;
}

.m-level-check {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-2) 100%);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---------- 每日目标 ---------- */
.m-goals {
  display: flex;
  gap: 16rpx;
}

.m-goal {
  flex: 1;
  height: 88rpx;
  border-radius: var(--r-sm);
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 300;
  transition: border-color 0.2s ease, background 0.2s ease;
}

.m-goal-on {
  border-color: rgba(100, 210, 255, 0.75);
  background: rgba(100, 210, 255, 0.18);
  color: #fff;
}

.m-goal-tip {
  margin-top: 20rpx;
  font-size: 22rpx;
  font-weight: 300;
}

/* ---------- 数据行 ---------- */
.m-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  font-size: 30rpx;
  font-weight: 300;
}

.m-row + .m-row {
  border-top: 1rpx solid rgba(255, 255, 255, 0.14);
}

.m-row-arrow {
  color: rgba(255, 255, 255, 0.4);
  font-size: 40rpx;
  line-height: 1;
}

.m-foot {
  text-align: center;
  margin-top: 40rpx;
  font-size: 22rpx;
  font-weight: 300;
}
