<view class="bg">
  <view class="blob blob-1"></view>
  <view class="blob blob-2"></view>
  <view class="blob blob-3"></view>
</view>

<view class="study">
  <!-- 顶部：退出 + 进度 -->
  <view class="study-top">
    <view class="study-close" hover-class="study-close-hover" bindtap="onClose">✕</view>
    <view class="study-prog num">
      <text class="study-prog-cur">{{done}}</text>
      <text class="t3"> / {{total}}</text>
    </view>
    <view class="chip">{{levelName}}</view>
  </view>
  <view class="study-bar">
    <view class="study-bar-fill" style="width:{{barPct}}%"></view>
  </view>

  <!-- 学习中 -->
  <block wx:if="{{!finished}}">
    <view class="study-stage" wx:if="{{showCard}}">
      <word-card class="fade-up" item="{{item}}" revealed="{{revealed}}" bind:cardtap="onCardTap" />
    </view>

    <!-- 已看完释义：进入下一个 -->
    <view class="study-actions" wx:if="{{rated}}">
      <view class="btn btn-primary study-next" hover-class="btn-soft" bindtap="onNext">下一个</view>
    </view>
    <view class="study-tip t3" wx:if="{{rated}}">
      {{rating === 'wrong' ? '已记下：这个词会更快再出现' : '已记下：明天再来复习'}}
    </view>

    <!-- 未评价：认识直接跳过 / 不认识先看释义 -->
    <view class="study-actions" wx:else>
      <view class="ra ra-wrong" hover-class="ra-hover" bindtap="onUnknow" data-r="wrong">
        <text class="ra-title">不认识</text>
      </view>
      <view class="ra ra-vague" hover-class="ra-hover" bindtap="onUnknow" data-r="vague">
        <text class="ra-title">模糊</text>
      </view>
      <view class="ra ra-right" hover-class="ra-hover" bindtap="onKnow">
        <text class="ra-title">认识</text>
      </view>
    </view>
    <view class="study-tip t3" wx:if="{{!rated}}">点「认识」直接过；点「不认识」会先显示中文</view>
  </block>

  <!-- 完成：已自动打卡 -->
  <block wx:else>
    <view class="study-done card pop">
      <view class="study-done-badge">✓</view>
      <view class="h2">本轮学习完成</view>
      <view class="study-done-checkin" wx:if="{{checkinMsg}}">{{checkinMsg}}</view>
      <view class="study-done-grid num">
        <view class="study-done-cell">
          <view class="study-done-num" style="color:#248A3D">{{counts.right}}</view>
          <view class="t3 study-done-label">认识</view>
        </view>
        <view class="study-done-cell">
          <view class="study-done-num" style="color:#FF9500">{{counts.vague}}</view>
          <view class="t3 study-done-label">模糊</view>
        </view>
        <view class="study-done-cell">
          <view class="study-done-num" style="color:#FF3B30">{{counts.wrong}}</view>
          <view class="t3 study-done-label">不认识</view>
        </view>
      </view>
      <view class="study-done-btns">
        <view class="study-more-label t3">继续加练，再来一批</view>
        <view class="study-more-row">
          <view class="ra ra-more" hover-class="ra-hover" bindtap="onContinue" data-n="10">
            <text class="ra-title">10 词</text>
          </view>
          <view class="ra ra-more" hover-class="ra-hover" bindtap="onContinue" data-n="15">
            <text class="ra-title">15 词</text>
          </view>
          <view class="ra ra-more" hover-class="ra-hover" bindtap="onContinue" data-n="20">
            <text class="ra-title">20 词</text>
          </view>
        </view>
        <view class="btn btn-ghost" bindtap="onClose">回首页</view>
      </view>
    </view>
  </block>
</view>
