.study {
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

/* ---------- 顶部 ---------- */
.study-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.study-close {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.62);
  -webkit-backdrop-filter: blur(16px);
  backdrop-filter: blur(16px);
  border: 1rpx solid var(--glass-line);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-2);
  font-size: 30rpx;
}

.study-close-hover {
  transform: scale(0.92);
}

.study-prog {
  font-size: 30rpx;
  font-weight: 300;
}

.study-prog-cur {
  font-weight: 500;
  font-size: 36rpx;
}

.study-bar {
  margin-top: 24rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: var(--track);
  overflow: hidden;
}

.study-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--brand) 0%, var(--brand-2) 100%);
  transition: width 0.45s cubic-bezier(0.22, 1, 0.36, 1);
}

/* ---------- 卡片舞台 ---------- */
.study-stage {
  flex: 1;
  margin-top: 32rpx;
  min-height: 0;
}

/* ---------- 评价按钮 ---------- */
.study-actions {
  margin-top: 40rpx;
  display: flex;
  gap: 20rpx;
}

.ra {
  flex: 1;
  height: 108rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
  border: 1rpx solid var(--glass-line);
  -webkit-backdrop-filter: blur(20px);
  backdrop-filter: blur(20px);
  box-shadow: inset 0 1rpx 0 var(--glass-hi);
  background: rgba(255, 255, 255, 0.62);
  transition: transform 0.12s ease, opacity 0.25s ease;
}

/* 柔和一点的按压反馈：只变淡，不缩放 */
.ra-hover { opacity: 0.72; }
.btn-soft { opacity: 0.82; }

.study-next {
  width: 100%;
}

.ra-title { color: inherit; }

.ra-wrong { background: rgba(255, 59, 48, 0.14); color: #FF3B30; }
.ra-vague { background: rgba(255, 149, 0, 0.18); color: #C77700; }
.ra-right { background: rgba(52, 199, 89, 0.16); color: #248A3D; }

/* 认识：释义已展开时高亮，提示"点卡片也能达到同样效果" */
.ra-active {
  border-color: rgba(52, 199, 89, 0.55);
  box-shadow: inset 0 1rpx 0 var(--glass-hi), 0 0 0 2rpx rgba(52, 199, 89, 0.18);
}

/* 已废弃的禁用态保留占位，避免旧样式引用报错 */
.ra-off {
  opacity: 0.32;
  pointer-events: none;
}

.study-tip {
  text-align: center;
  margin-top: 24rpx;
  font-size: 24rpx;
  font-weight: 300;
}

/* ---------- 完成态 ---------- */
.study-done {
  flex: 1;
  margin-top: 32rpx;
  padding: 64rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
}

.study-done-badge {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(10, 132, 255, 0.9) 0%, rgba(94, 92, 230, 0.9) 100%);
  color: #fff;
  font-size: 60rpx;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-float);
}

/* 自动打卡提示 */
.study-done-checkin {
  background: rgba(52, 199, 89, 0.16);
  color: #248A3D;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.study-done-grid {
  width: 100%;
  display: flex;
  margin-top: 16rpx;
}

.study-done-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.study-done-num {
  font-size: 52rpx;
  font-weight: 300;
}

.study-done-label {
  font-size: 24rpx;
  font-weight: 300;
}

.study-done-btns {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 24rpx;
}
