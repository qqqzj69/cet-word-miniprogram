.study {
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ---------- 顶部 ---------- */
.study-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.study-close {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--card);
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-2);
  font-size: 30rpx;
}

.study-close-hover {
  transform: scale(0.92);
}

.study-prog {
  font-size: 30rpx;
}

.study-prog-cur {
  font-weight: 700;
  font-size: 36rpx;
}

.study-bar {
  margin-top: 24rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--bg-soft);
  overflow: hidden;
}

.study-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--brand) 0%, var(--brand-2) 100%);
  transition: width 0.45s cubic-bezier(0.22, 1, 0.36, 1);
}

/* ---------- 卡片舞台 ---------- */
.study-stage {
  flex: 1;
  margin-top: 32rpx;
  min-height: 0;
}

/* ---------- 评价按钮 ---------- */
.study-actions {
  margin-top: 40rpx;
  display: flex;
  gap: 20rpx;
}

.ra {
  flex: 1;
  height: 108rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  transition: transform 0.12s ease, opacity 0.25s ease;
}

.ra-hover { transform: scale(0.95); }

.ra-title { color: inherit; }

.ra-wrong { background: rgba(255, 107, 91, 0.12); color: var(--coral); }
.ra-vague { background: rgba(245, 166, 35, 0.14); color: var(--amber); }
.ra-right { background: rgba(22, 163, 74, 0.12); color: var(--green); }

.ra-off {
  opacity: 0.35;
  pointer-events: none;
}

.study-tip {
  text-align: center;
  margin-top: 24rpx;
  font-size: 24rpx;
}

/* ---------- 完成态 ---------- */
.study-done {
  flex: 1;
  margin-top: 32rpx;
  padding: 64rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
}

.study-done-badge {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-2) 100%);
  color: #fff;
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-float);
}

.study-done-grid {
  width: 100%;
  display: flex;
  margin-top: 16rpx;
}

.study-done-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.study-done-num {
  font-size: 48rpx;
  font-weight: 700;
}

.study-done-label {
  font-size: 24rpx;
}

.study-done-btns {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 24rpx;
}
