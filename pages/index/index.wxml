<view class="bg">
  <view class="blob blob-1"></view>
  <view class="blob blob-2"></view>
  <view class="blob blob-3"></view>
</view>

<view class="page-pad" wx:if="{{ov}}">
  <!-- 顶层：日期 + 打卡状态灯 + 搜索（工具条，刻意做小） -->
  <view class="topbar fade-up">
    <view class="topbar-left">
      <text class="topbar-date num">{{ov.date}} {{ov.weekday}}</text>
      <view
        class="ck {{ov.checkedToday ? 'ck-on' : ''}}"
        hover-class="ck-hover"
        bindtap="onCheckin"
      >
        <view class="ck-led"></view>
        <text class="ck-text">{{ov.checkedToday ? '已打卡' : '未打卡'}}</text>
      </view>
    </view>

    <view class="sbox">
      <text class="sbox-icon">🔍</text>
      <input
        class="sbox-input"
        placeholder="查单词"
        placeholder-class="sbox-ph"
        value="{{kw}}"
        confirm-type="search"
        bindinput="onSearchInput"
        bindconfirm="goSeeAll"
      />
      <text class="sbox-clear" wx:if="{{kw}}" catchtap="onClearSearch">✕</text>
    </view>
  </view>

  <!-- 搜索结果（仅在输入时出现） -->
  <view class="card sres fade-up" wx:if="{{searching}}">
    <view class="sres-row" wx:for="{{results}}" wx:key="i" bindtap="goSeeAll">
      <text class="sres-en">{{item.w}}</text>
      <text class="t3 sres-cn">{{item.m}}</text>
    </view>
    <view class="t3 sres-empty" wx:if="{{results.length === 0}}">没有找到「{{kw}}」</view>
    <view class="sres-more" wx:else bindtap="goSeeAll">查看全部结果 ›</view>
  </view>

  <!-- 唯一视觉焦点：开始学习 -->
  <view class="card hero fade-up" wx:else>
    <view class="hero-ring-wrap">
      <progress-ring percent="{{percent}}" size="360" stroke="22">
        <view class="hero-ring">
          <view class="hero-num num">{{ov.done}}</view>
          <view class="t3 hero-sub">/ {{ov.queueTotal}} 词</view>
        </view>
      </progress-ring>
    </view>
    <view class="btn btn-primary hero-btn" hover-class="hero-btn-hover" bindtap="goStudy">
      {{heroBtn}}
    </view>
    <view class="t3 hero-foot num" wx:if="{{showRemaining}}">今天还差 {{remaining}} 词</view>
    <view class="t3 hero-foot num" wx:else>今日已学 {{ov.today.learned}} 词 · 连续 {{ov.streak}} 天</view>
  </view>

  <!-- 辅助入口（弱化：三个紧凑入口 + 一行进度） -->
  <view class="card aux fade-up">
    <view class="aux-row">
      <view class="aux-item" bindtap="goWrong" hover-class="aux-hover">
        <view class="aux-value num" style="color:#FF3B30">{{ov.acc.wrong}}</view>
        <view class="t3 aux-label">错词本</view>
      </view>
      <view class="aux-item" bindtap="goHistory" hover-class="aux-hover">
        <view class="aux-value num" style="color:var(--brand)">{{historyDays}}</view>
        <view class="t3 aux-label">学习历史</view>
      </view>
      <view class="aux-item" bindtap="goSearch" hover-class="aux-hover">
        <view class="aux-value num" style="color:var(--brand-2)">{{ov.acc.mastered}}</view>
        <view class="t3 aux-label">已掌握</view>
      </view>
    </view>
    <view class="prog-bar">
      <view class="prog-fill" style="width:{{ov.acc.total ? (ov.acc.learned * 100 / ov.acc.total) : 0}}%"></view>
    </view>
    <view class="t3 aux-foot num">{{ov.levelName}} 已学 {{ov.acc.learned}} / {{ov.acc.total}} 词</view>
  </view>
</view>
