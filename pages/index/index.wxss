.head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 24rpx 8rpx 32rpx;
}

.head-date {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 300;
}

/* ---------- 今日任务主卡 ---------- */
.hero {
  padding: 48rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

.hero-ring {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.hero-sub {
  font-size: 24rpx;
  margin-top: 2rpx;
}

.hero-btn {
  width: 100%;
}

.hero-foot {
  font-size: 24rpx;
  font-weight: 300;
}

/* ---------- 通用行卡片 ---------- */
.row-card {
  margin-top: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row-hover {
  transform: scale(0.985);
  transition: transform 0.12s ease;
}

.row-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.row-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
}

.row-sub {
  font-size: 24rpx;
  margin-top: 4rpx;
  font-weight: 300;
}

.row-arrow {
  color: var(--ink-3);
  font-size: 44rpx;
  line-height: 1;
}

.chip-done {
  background: rgba(52, 199, 89, 0.16);
  color: #248A3D;
  border-color: rgba(52, 199, 89, 0.30);
}

/* ---------- 词库进度 ---------- */
.prog-card {
  margin-top: 24rpx;
  padding: 32rpx;
}

.prog-bar {
  margin-top: 24rpx;
}

.prog-foot {
  margin-top: 16rpx;
  font-size: 24rpx;
  font-weight: 300;
}
