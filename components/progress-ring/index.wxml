<view
  class="ring"
  style="width:{{size}}rpx;height:{{size}}rpx;background:conic-gradient(from -90deg, var(--brand) 0, var(--brand-2) {{percent / 100}}turn, rgba(255,255,255,0.62) {{percent / 100}}turn 1turn)"
>
  <view
    class="ring-hole"
    style="width:calc({{size}}rpx - {{stroke * 2}}rpx);height:calc({{size}}rpx - {{stroke * 2}}rpx)"
  >
    <slot></slot>
  </view>
</view>
