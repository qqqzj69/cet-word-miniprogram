.ring {
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.6s ease;
  /* 未填充的底槽描边 */
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.14);
}

.ring-hole {
  /* 半透明内芯：让渐变天空透出来，形成玻璃环 */
  background: rgba(10, 16, 38, 0.30);
  -webkit-backdrop-filter: blur(24px) saturate(160%);
  backdrop-filter: blur(24px) saturate(160%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.22);
}
