.wc {
  width: 100%;
  height: 100%;
  perspective: 1600rpx;
}

.wc-inner {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
}

.wc.is-flipped .wc-inner {
  transform: rotateY(180deg);
}

.wc-face {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
  border-radius: 36rpx;
  /* 3D 变换的元素上 backdrop-filter 在部分机型会闪，
     改用多层半透明渐变模拟玻璃，视觉一致且稳妥 */
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.86) 0%, rgba(255, 255, 255, 0.62) 55%, rgba(255, 255, 255, 0.48) 100%);
  border: 1rpx solid var(--glass-line);
  box-shadow: var(--shadow-card), inset 0 1rpx 0 var(--glass-hi);
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  overflow: hidden;
}

.wc-front {
  gap: 40rpx;
}

.wc-back {
  transform: rotateY(180deg);
  align-items: flex-start;
  justify-content: flex-start;
  gap: 24rpx;
}

.wc-word {
  font-size: 84rpx;
  font-weight: 300;
  letter-spacing: -2rpx;
  color: var(--ink);
  word-break: break-all;
  text-align: center;
  line-height: 1.2;
}

.wc-word-sm {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--brand);
}

.wc-meaning {
  font-size: 34rpx;
  line-height: 1.75;
  font-weight: 300;
  color: var(--ink-2);
  word-break: break-all;
}

.wc-scroll {
  width: 100%;
  height: 100%;
  flex: 1;
}

.wc-hint {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--ink-3);
  font-size: 24rpx;
}

.wc-hint-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--ink-3);
  animation: hintPulse 1.8s ease-in-out infinite;
}

@keyframes hintPulse {
  0%, 100% { opacity: 0.4; transform: scale(0.85); }
  50% { opacity: 1; transform: scale(1.15); }
}
