.wc {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  border-radius: 36rpx;
  /* 多层半透明渐变模拟玻璃：3D 变换元素上 backdrop-filter 在部分机型会闪，这里不用 */
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.86) 0%, rgba(255, 255, 255, 0.62) 55%, rgba(255, 255, 255, 0.48) 100%);
  border: 1rpx solid var(--glass-line);
  box-shadow: var(--shadow-card), inset 0 1rpx 0 var(--glass-hi);
  overflow: hidden;
  transition: transform 0.12s ease, border-color 0.2s ease;
}

/* 已显示释义：描边变蓝，明确区分"可再点一次"的状态 */
.wc.is-revealed {
  border-color: rgba(10, 132, 255, 0.45);
}

.wc-hover {
  transform: scale(0.995);
}

.wc-body {
  width: 100%;
  height: 100%;
  padding: 56rpx 40rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

.wc-word-wrap {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wc-word {
  font-size: 84rpx;
  font-weight: 300;
  letter-spacing: -2rpx;
  color: var(--ink);
  word-break: break-all;
  text-align: center;
  line-height: 1.2;
}

/* 释义区：出现即可读，不占满时不影响单词位置过大跳动 */
.wc-meaning-wrap {
  flex: 1;
  width: 100%;
  min-height: 0;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--hair);
  animation: meaningIn 0.18s ease-out both;
}

@keyframes meaningIn {
  from { opacity: 0; transform: translateY(-8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.wc-meaning {
  font-size: 34rpx;
  line-height: 1.75;
  font-weight: 300;
  color: var(--ink-2);
  word-break: break-all;
}

.wc-scroll {
  width: 100%;
  height: 100%;
}

.wc-hint {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  font-weight: 300;
}

.wc-hint-go {
  color: var(--brand);
}

.wc-hint-go .wc-hint-dot {
  background: var(--brand);
}

.wc-hint-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--ink-3);
  animation: hintPulse 1.8s ease-in-out infinite;
}

@keyframes hintPulse {
  0%, 100% { opacity: 0.4; transform: scale(0.85); }
  50% { opacity: 1; transform: scale(1.15); }
}
