<view class="wc {{revealed ? 'is-revealed' : ''}}" bindtap="onTap" hover-class="wc-hover" wx:if="{{item}}">
  <view class="wc-body">
    <!-- 单词：始终展示 -->
    <view class="wc-word-wrap">
      <text class="wc-word">{{item.w}}</text>
    </view>

    <!-- 中文释义：点击后直接出现，无翻卡动画 -->
    <view class="wc-meaning-wrap" wx:if="{{revealed}}">
      <scroll-view scroll-y class="wc-scroll" enhanced show-scrollbar="{{false}}">
        <text class="wc-meaning">{{item.m}}</text>
      </scroll-view>
    </view>

    <!-- 行为提示：明确告诉用户点一下会发生什么 -->
    <view class="wc-hint">
      <view class="wc-hint-dot"></view>
      <text wx:if="{{revealed}}">已显示释义，再次轻点可收起</text>
      <text wx:else>轻点卡片查看中文释义</text>
    </view>
  </view>
</view>
